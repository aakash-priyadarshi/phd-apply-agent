# Copy this file to .env and fill in your local values.
OPENAI_API_KEY=
# Optional for higher OpenAlex API limits; author search works without it.
OPENALEX_API_KEY=
USER_NAME=
USER_EMAIL=

# Optional absolute path for local runtime files. Defaults to ./data.
# PHD_AGENT_DATA_DIR=

# Legacy bulk sending stays disabled until the reviewed outreach queue is built.
AUTO_SEND_ENABLED=false
