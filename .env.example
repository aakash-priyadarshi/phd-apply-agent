# Copy this file to .env and fill in your local values.
PHD_AGENT_ENV=development
# Required for unauthenticated local use. Ignored when PHD_AGENT_ENV=production or Railway is detected.
PHD_AGENT_AUTH_DISABLED=true
OPENAI_API_KEY=
# Optional for higher OpenAlex API limits; author search works without it.
OPENALEX_API_KEY=
USER_NAME=
USER_EMAIL=

# Optional absolute path for local runtime files. Defaults to ./data.
# PHD_AGENT_DATA_DIR=

# Hosted Railway values (do not use AUTH_DISABLED there):
# PHD_AGENT_ENV=production
# PHD_AGENT_DATA_DIR=/data
# PHD_AGENT_ALLOWED_EMAILS=you@example.com
# PHD_AGENT_OIDC_CLIENT_ID=
# PHD_AGENT_OIDC_CLIENT_SECRET=
# PHD_AGENT_OIDC_COOKIE_SECRET=
# PHD_AGENT_OIDC_REDIRECT_URI=https://your-service.up.railway.app/oauth2callback
# Optional Gmail bootstrap onto the volume (never commit these values):
# PHD_AGENT_GMAIL_CREDENTIALS_JSON=
# PHD_AGENT_GMAIL_TOKEN_JSON=

# Legacy bulk sending stays disabled. The application never honors AUTO_SEND_ENABLED=true.
AUTO_SEND_ENABLED=false
